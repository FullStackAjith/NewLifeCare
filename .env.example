# Copy to .env on the server. Never commit real credentials.
PORT=3000
DATA_DIR=./data

# Optional staff notification email. Enquiries are stored in SQLite even if SMTP is not configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
ENQUIRY_TO_EMAIL=newlifecarecbe@gmail.com
ENQUIRY_FROM_EMAIL=

# Required to enable real AI chat. Keep this key on the server only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Frontend (build-time). Set to true ONLY after the centre confirms enquiries are monitored 24/7.
VITE_ENQUIRIES_247=false
# Optional: API base if the API is hosted on another origin (default /api)
# VITE_API_BASE=/api
